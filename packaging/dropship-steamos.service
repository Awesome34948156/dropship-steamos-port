[Unit]
Description=Dropship for SteamOS — cgroup-scoped Overwatch 2 region blocks
Documentation=https://github.com/stowmyy/dropship

# nftables is not a service on SteamOS, but naming it costs nothing and is
# correct where it does exist. The watcher tolerates nft being unavailable: it
# logs and retries rather than exiting.
After=network.target nftables.service
Wants=nftables.service

[Service]
Type=simple
# The config path is substituted by packaging/install.sh. It must be absolute:
# this runs as root, where $HOME is /root and a relative path means something
# else entirely.
ExecStart=/var/lib/dropship-steamos/dropship-steamos-helper watch --config @CONFIG@

# ExecStopPost, not ExecStop. ExecStop runs while the watcher is still alive, so
# it could re-apply the rules in the window before it is killed, stranding drop
# rules with nothing left running to remove them. ExecStopPost runs after the
# process is gone, which is the only point at which "removed" stays removed.
ExecStopPost=/var/lib/dropship-steamos/dropship-steamos-helper disable

Restart=on-failure
RestartSec=5s

# firewall.rs resolves `nft` through PATH. That lookup now happens as root, from
# a unit whose environment is not a login shell's, so it is pinned rather than
# inherited.
Environment=PATH=/usr/bin:/usr/sbin:/bin:/sbin

# --- Sandboxing -------------------------------------------------------------
# These are defence in depth and are the lines most likely to need relaxing.
# If the service starts but never applies rules, check
# `journalctl -u dropship-steamos`, then try commenting out the block below and
# running `systemctl daemon-reload && systemctl restart dropship-steamos`.
# The feature itself needs: read the config, read /proc, read /sys/fs/cgroup,
# fork nft, and write /run/dropship-steamos.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
LockPersonality=yes
# Two capabilities, each the narrowest one that does its job.
#
#   CAP_NET_ADMIN       — create and remove the nftables table.
#   CAP_DAC_READ_SEARCH — read the config file. It lives under /home/deck, which
#     is mode 0700, so reaching it means traversing a directory this process does
#     not own. Root normally bypasses that check; a process held to a bounding
#     set does not. Without this the watcher cannot even stat its own config — it
#     logs "Permission denied" once and then idles forever, which is
#     indistinguishable from "no game is running". Measured on the Deck
#     2026-10-02: /home/deck is 0700 and this was the whole failure.
#
# Note what is deliberately absent. Reading /proc/<pid>/cmdline for another
# user's process looks like it ought to need CAP_SYS_PTRACE, and that was the
# first guess. Measured on the Deck the same day: it does not — `deck` can read
# root's own /proc/1/cmdline — so adding it would have been pure widening.
#
# CAP_DAC_READ_SEARCH is the one real cost here: the daemon can now read files it
# does not own. It never prints file contents, so the reachable harm is a parse
# error in the journal rather than a disclosure — but it is a genuine widening,
# and the reason to keep this list at two. The alternative, moving the config
# where root can reach it without the capability, means changing the installer,
# the GUI and the docs, and belongs in its own change rather than in a bug fix.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_READ_SEARCH

# systemd creates and owns this, and removes it when the service stops. The
# mode is what lets the unprivileged GUI read the published state.
RuntimeDirectory=dropship-steamos
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
